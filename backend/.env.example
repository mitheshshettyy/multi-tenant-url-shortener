# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
# Allow the Vite dev server origin. The frontend proxy forwards /api/* to
# the backend, but CORS is still validated on the OPTIONS preflight.
CORS_ORIGIN=http://127.0.0.1:5173

# Logging
LOG_LEVEL=info

# Database
# docker-compose.yml starts Postgres and maps host port 5433 → container
# port 5432. If you are using the Docker-managed database, use port 5433.
# If you already have a native Postgres installation running on port 5432,
# use port 5432 (the NestJS backend connects to whichever is listening).
# Default below matches the docker-compose.yml Docker host port.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/url_shortener

# Cache (matches docker-compose.yml defaults — no changes needed for local dev)
REDIS_URL=redis://127.0.0.1:6379

# Auth
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-please-32-chars-min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-please-32-chars-min
JWT_REFRESH_EXPIRES_IN=7d
