VITE_API_BASE_URL=/api/v1
# Base URL of the backend redirect service. In local development this is
# the NestJS backend (port 3000), NOT the Vite dev server (port 5173).
# The React app uses this to construct the full short URL shown in the UI
# (e.g. http://localhost:3000/abc123). In production, set this to your
# public domain (e.g. https://short.example.com).
VITE_SHORT_LINK_BASE_URL=http://localhost:3000
